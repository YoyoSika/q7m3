struct GroundSurface {
  // Albedo (linear) after every detail.
  vec3 albedo;
  // Tangential slope of the shading normal (N = grTilt(n, slope)); 0 on water and ice.
  vec3 slope;
  // Water 0–1 (ice-covered sea counts as land here), ice cover, the land field, the relief (0 where not evaluated).
  float water, polar, land, relief;
  // Water roughness² (with the sea wind) before the resolved waves are taken out.
  float a2;
  // City-light density where known (the cache); -1: groundLight derives it from land, polar and relief.
  float city;
  // Gain of the 0.7 m octave groundLight adds per pixel (the cache's pixels); 0 where it is in albedo and slope already.
  float fine;
};
/*
 * The surface half. n: unit normal (map basis); V: toward the eye (only the rock strata's footprint on a
 * face uses it; the bake passes n); fp: pixel footprint (m); detail: 0 = the TypeScript mirror (flat, no
 * noise), 1 = full. near: 1 on the launch patch, where loc (site metres: x east, y north), east/north
 * (map basis) are valid. With GR_NEAR3 the metre octaves also run in planet-fixed 3D at weight 1 − near.
 */
