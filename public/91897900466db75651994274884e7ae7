  vec3 q=n*GEO_R_KM;
  geoBakeSet(fp);
  float land=landAt(n), blur=fp*GR_LAND_M;
#ifdef GEO_BAKE_COVER
  geoCover=groundCoverBlur(n,land,fp);
#endif
