// The windows' part of a pixel of footprint fp (A, B weighted; the returned weight's rest is the cube's, read at its
// level 0): the two levels its footprint falls between, as the cube's trilinear read would have picked them had it
// those levels; finer than the finest level, that level magnified. Only levels lo..hi take part (the tile's static
// window sits between two calls: the levels finer than it, then it, then the coarser ones).
float geoWinRead(vec3 n, float fp, int lo, int hi, out vec4 A, out vec4 B){
  A=vec4(0.); B=vec4(0.);
  float L=geoWinInfo.x;
  if(L<=0.||hi<lo) return 0.;
  float lam=-log2(fp/(geoAlbedoInfo.x*geoAlbedoTexel(n)));
  if(lam<=0.) return 0.;
  lam=min(lam,L);
  int k1=int(ceil(lam))-1;
  float f=lam-float(k1), total=0.;
  vec4 a, b;
  // What the finer level lacks (outside its window, off, still rendering) the coarser ones fill in turn:
  // there is no procedural share here, and the cube's level 0 is far coarser than any window.
  float need=1., w=0.;
  if(k1>=lo&&k1<=hi){ w=geoWinAt(k1,n,a,b)*f; if(w>0.){ A+=a*w; B+=b*w; total+=w; need-=w; } }
  for(int k=min(k1-1,hi);k>=lo;k--){
    w=geoWinAt(k,n,a,b)*need;
    if(w>0.){ A+=a*w; B+=b*w; total+=w; need-=w; }
    if(need<=.002) break;
  }
  return total;
}
// The detail tile's static window (GEO_TILE_WIN, geoAlbedo.ts): the same two encodings (layer 0 = A, layer 1 = B)
// over the whole Himalaya tile at a fraction of its resolution, with mips. It is one more level of the window
// chain, placed by its texel: the nadir levels finer than it are read first, then it, then the coarser levels and
// the cube — the cube's level 0 is far coarser than the tile (the tile fades out of it) and the coarse nadir levels
// span the whole tile, so without this the mountains blur to those levels' texels (585 m 标准) and flatten past
// the windows and from orbit. geoTileInfo x: weight (0 off or not baked), y: its last mip, z: a texel's plane
// size (m) at the tile centre (a sphere texel is that / s^1.5, s = d · centre, as the windows'), w: unused.
uniform highp sampler2DArray geoTileWin; uniform vec4 geoTileInfo;
// The window's sphere texel at n (0: off, no tile, or n outside the tile), and its patch fractions + edge weight.
float geoTileAt(vec3 n, out vec2 ab, out float edge){
#ifdef GEO_TERRAIN
  if(geoTileInfo.x<=0.||terrainTile[0].w<.5) return 0.;
  vec3 d=tFromMap(n);
  float s=dot(d,terrainTile[0].xyz);
  if(s<=0.) return 0.;
  vec2 hw=terrainTile[3].xy, uv=vec2(dot(d,terrainTile[1].xyz),dot(d,terrainTile[2].xyz))/s, room=hw-abs(uv);
  if(room.x<=0.||room.y<=0.) return 0.;
  // The tile's own edge fade (tTileRaw): the window and the cube hold the same blended ground there.
  vec2 k=min(vec2(1.),room/terrainTile[2].w); k=k*k*(3.-2.*k);
  ab=(uv+hw)/(2.*hw); edge=k.x*k.y;
  return geoTileInfo.z/(s*sqrt(s));
#else
  ab=vec2(0.); edge=0.;
  return 0.;
#endif
}
// The first nadir level coarser than the tile window's texel ts at n (levels ≥ it are finer): level k's texel is
// the cube's / 2^(k+1).
int geoTileLevel(vec3 n, float ts){ return max(int(ceil(log2(geoAlbedoInfo.x*geoAlbedoTexel(n)/ts)-1.)),0); }
float geoTileRead(float fp, float ts, vec2 ab, float edge, out vec4 A, out vec4 B){
  float lod=clamp(log2(fp/ts),0.,geoTileInfo.y);
  A=textureLod(geoTileWin,vec3(ab,0.),lod); B=textureLod(geoTileWin,vec3(ab,1.),lod);
