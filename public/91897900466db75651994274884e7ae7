float grVis(float nl, float nv, float a2){ float a=sqrt(a2); return .5/(nl*(nv*(1.-a)+a)+nv*(nl*(1.-a)+a)+1e-5); }
float grFresnel(float c){ float m=1.-c; return GR_F0+(1.-GR_F0)*m*m*m*m*m; }
