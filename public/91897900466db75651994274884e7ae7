// City lights (linear radiance before the night factor): towns and cities as soft points on
// inhabited lowland near coasts, few in the deserts (geoArid from surfaceFrom); each scale fades to its
// mean glow once cells approach the footprint.
float grCityScale(vec3 q, float cell, float radius, float chance, float dens, float fpKm){
  float mean=chance*dens*3.14159*radius*radius/(cell*cell);
  float blend=smoothstep(.12*cell,.45*cell,fpKm);
  if(blend>=1.) return mean;
  vec3 c=q/cell; ivec3 ci=ivec3(floor(c));
  float h=geoLattice(ci+ivec3(7,3,1)), lit=0.;
  if(h<chance*dens){
    vec3 off=vec3(geoLattice(ci+ivec3(13,0,0)),geoLattice(ci+ivec3(0,17,0)),geoLattice(ci+ivec3(0,0,19)))*.6+.2;
    vec3 centre=normalize((floor(c)+off)*cell)*GEO_R_KM;
    float r=radius*(.45+.9*h/(chance*dens)), s2=r*r+.25*fpKm*fpKm, d=length(q-centre);
    lit=(r*r/s2)*exp(-d*d/s2)*(.6+.4*geoNoise(q/(.35*r)+3.));
  }
  return mix(lit,mean,blend);
}
// The density's coastal share (inhabited lowland near coasts, none on the ice).
float grCityLand(float land, float polar){ return smoothstep(.0008,.004,land)*(1.-.6*smoothstep(.08,.4,land))*(1.-polar); }
// Its static rest (lowland, the 120 km regions, few in the deserts: geoArid of the last surfaceFrom); geoAlbedo bakes it.
float grCityStatic(vec3 q, float relief){
  float r=1.-smoothstep(.1,.3,relief);
  return r>0.?r*smoothstep(-.3,.35,geoNoise(q/120.+131.))*(1.-.85*geoArid):0.;
}
float grCityLights(vec3 q, float dens, float fp){
  if(dens<=0.) return 0.;
  float fpKm=fp*.001;
  return grCityScale(q,9.,.6,.8,dens,fpKm)+.7*grCityScale(q,3.1,.28,.65,dens,fpKm);
}
float grCity(vec3 q, float land, float relief, float polar, float fp){
  // The cheap factors first: the noise only where they leave some density.
  float dens=grCityLand(land,polar);
  return dens>0.?grCityLights(q,dens*grCityStatic(q,relief),fp):0.;
}
// The baked far surface's tangent frame at n (the aux cube's slope is stored in it; bake and read agree):
// E east (the polar axis is y), N north; at the poles a fixed frame.
void grTangent(vec3 n, out vec3 E, out vec3 N){
  E=length(n.xz)>1e-4?normalize(vec3(n.z,0.,-n.x)):vec3(1.,0.,0.);
  N=cross(n,E);
}
// The aux cube's bytes: r city-light density (grCityLand × grCityStatic), gb the slope's E and N components
// compressed as s / (1 + |s|), a the land field over ±GEO_AUX_LAND.
const float GEO_AUX_LAND=${IG(TG.auxLand)};
vec4 geoAuxEncode(float city, vec2 slope, float land){
  vec2 c=slope/(1.+abs(slope));
  return vec4(clamp(city,0.,1.),c*.5+.5,clamp(land/GEO_AUX_LAND,-1.,1.)*.5+.5);
}
#ifdef GEO_ALBEDO
// The far globe's baked surface (GEO_ALBEDO, geoAlbedo.ts): geoAlbedo rgb = groundSurface's albedo
// ^(1/2.2), a = its ice cover, each mip level shaded at that level's texel footprint; geoAlbedoAux:
// geoAuxEncode of the same surface, box-filtered. geoAlbedoInfo x: the albedo cube's level-0 texel
// footprint (m) at a face centre (0: not baked), y: its last level; z, w: the same for the aux cube.
uniform highp samplerCube geoAlbedo; uniform highp samplerCube geoAlbedoAux; uniform vec4 geoAlbedoInfo;
// A cube texel's footprint at n over the face centre's: c^1.5, c the largest component (its solid angle goes as c³).
float geoAlbedoTexel(vec3 n){ vec3 a=abs(n); float c=max(a.x,max(a.y,a.z)); return c*sqrt(c); }
vec4 geoAlbedoAt(vec3 n, float fp){ return textureLod(geoAlbedo,n,clamp(log2(fp/(geoAlbedoInfo.x*geoAlbedoTexel(n))),0.,geoAlbedoInfo.y)); }
vec4 geoAlbedoAuxAt(vec3 n, float fp){ return textureLod(geoAlbedoAux,n,clamp(log2(fp/(geoAlbedoInfo.z*geoAlbedoTexel(n))),0.,geoAlbedoInfo.w)); }
// The nadir detail windows (GEO_WINDOWS, geoAlbedo.ts): the same two encodings below the cube's level 0, level k at
// the cube's level-0 texel / 2^(k+1), each in its own gnomonic plane. geoWin[k]: x, y the window start (world texels
// of that plane), z its weight (0 off or not readable, fading in to 1), w the array layer; geoWinUp/East/North[k] the
// plane's frame; geoWinInfo x: levels (0 none), y: texels per side, z: R (m), w: the cube's level-0 texel (m).
uniform highp sampler2DArray geoWinA; uniform highp sampler2DArray geoWinB;
const int GEO_WIN_L=${TG.windowLevels};
uniform vec4 geoWin[GEO_WIN_L]; uniform vec3 geoWinUp[GEO_WIN_L]; uniform vec3 geoWinEast[GEO_WIN_L]; uniform vec3 geoWinNorth[GEO_WIN_L];
uniform vec4 geoWinInfo;
// Level k's share of the pixel at n: 1 inside its window, fading over the outer tenth, 0 outside, off or past
// its plane's reach; A, B its texels (the storage wraps: the stored texel is the world texel mod size).
float geoWinAt(int k, vec3 n, out vec4 A, out vec4 B){
  vec4 l=geoWin[k];
  if(l.z<=0.) return 0.;
  float c=dot(n,geoWinUp[k]);
  if(c<.5) return 0.;
  float texel=geoWinInfo.w/exp2(float(k+1)), size=geoWinInfo.y;
  vec2 I=geoWinInfo.z*vec2(dot(n,geoWinEast[k]),dot(n,geoWinNorth[k]))/(c*texel);
