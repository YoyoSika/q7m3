// Bare ground by slope (GEO.slope): x scree, y rock wall cover (0–1) for the drawn slope tanS
// (the length of grRidges), the edges broken up by the zero-mean tone m; snow (geoSnow from
// surfaceFrom) holds a few degrees more, and pixels wider than the fade keep the geography colour.
vec2 grSlopeClass(float tanS, float m, float fp){
  float k=1.-smoothstep(GR_SLOPE_K.y,GR_SLOPE_K.z,fp);
  if(k<=0.||tanS<=0.) return vec2(0.);
  float deg=degrees(atan(tanS))+8.*m-GR_SLOPE_K.x*geoSnow;
  return vec2(smoothstep(GR_SLOPE_DEG.x,GR_SLOPE_DEG.y,deg),smoothstep(GR_SLOPE_DEG.z,GR_SLOPE_DEG.w,deg))*k;
