vec3 grLimbGround(vec3 n, vec3 V, vec3 s){
  float day=daylight(n,s), mu=dot(n,s), nv=clamp(dot(n,V),0.,1.);
  vec3 sun=atmSunTransmittance(n*ATM_R,s)/ATM_ZENITH_SUN*day*mix(vec3(1.),GR_TERM,GR_TERM_K*(1.-smoothstep(.02,.22,mu)));
  float skyScale=day*(.35+.65*grLum(sun));
  vec3 lf=GR_NIGHT*mix(GR_NIGHT_TINT,vec3(1.),day)+sun*GR_DIRECT*max(mu,0.)+GR_SKY*GR_TINT*skyScale;
  float F=grFresnel(nv), water=1.-smoothstep(-.0003,.0008,landAtP(n));
  vec3 sea=GR_LIMB_SEA*(1.-F)*lf+F*mix(GR_SKY_H,GR_SKY_Z,sqrt(nv))*skyScale;
  return mix(GR_LIMB_LAND*lf,sea,water);
}
/*
 * The ground in two halves (render review wave 3). groundSurface is everything that depends only on
 * the ground point and the pixel footprint: the geography's colour, the land and ice fields, the
 * relief and noise slopes, the slope classes and strata, the fields, scrub, sand and shore bands.
 * groundLight is everything the sun, the eye, time or the craft change: sunlight through the air,
 * cloud shadow, skylight, the waves, foam and wake, the water's Fresnel and glint, paint, lamps and
 * the city lights. groundShade is the second over the first. The near-ground surface cache
 * (surfaceCache.ts; GR_SURFACE_CACHE in the near materials, GR_SURFACE_BAKE in its bake) stores the
 * first in rings around the craft and runs only the second per pixel.
 */
