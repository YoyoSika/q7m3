// Rock strata in [-1,1], zero mean: layers of the drawn height h (m), warped by up to 5 m over
// ~60 m (q: km), more marked on some stretches of the face. Each octave is a hard band while
// resolved and softens and fades to 0 as the footprint fp (m, on the face) reaches its thickness.
float grStrata(float h, vec3 q, float fp){
  float k1=grFade(GR_STRATA.x,fp);
  if(k1<=0.) return 0.;
  float w=h+5.*geoNoise(q/.06+71.), e1=.2+fp/GR_STRATA.x;
  float s=(2.*smoothstep(-e1,e1,geoNoise(vec3(w/GR_STRATA.x,.37,17.)))-1.)*k1, k2=grFade(GR_STRATA.y,fp);
  if(k2>0.){ float e2=.2+fp/GR_STRATA.y; s+=.5*(2.*smoothstep(-e2,e2,geoNoise(vec3(w/GR_STRATA.y,.71,29.)))-1.)*k2; }
  // Some stretches of the face are more layered than others (~150 m).
  return s/1.5*(.6+.4*geoNoise(q/.15+83.));
}
// The bare ground's albedo (linear) over the geography's a: scree (cls.x) and rock (cls.y), each
// keeping GR_BARE_HUE of a's hue (desert rock stays warm); t: the zero-mean grain tone, st: the strata.
vec3 grBare(vec3 a, vec2 cls, float t, float st){
  vec3 tint=mix(vec3(1.),a/max(grLum(a),.002),GR_BARE_HUE);
  a=mix(a,GR_SCREE*tint*(1.+.5*t),cls.x*(1.-cls.y));
  return mix(a,GR_CLIFF*tint*(1.+.2*st+.35*t),cls.y);
}
#ifdef GEO_TERRAIN
// The strata at pixel n (map basis), on a face of slope vector s seen along V: the footprint fp
// (taken on the sphere) is re-projected onto the face, so a wall seen head-on keeps its layers.
float grStrataAt(vec3 n, vec3 V, vec3 s, vec3 q, float fp){
  float fpFace=fp*max(.25,dot(n,V))/max(.25,dot(grTilt(n,s),V));
