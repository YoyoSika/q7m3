  bool memo=vec4(q,land)==geoReliefKey&&fp*.001==geoReliefFp;
  float range=memo?geoReliefRange:geoRange(q,land);
  if(range<=0.) return vec3(0.);
  float h=memo?geoReliefH:geoReliefSum(q,fp*.001);
  if(h<=.25||h>=.85) return vec3(0.);
  vec3 g=vec3(0.);
  ${GU.relief.map((e,t)=>`{ float k=grFade(${IG(e.km*1e3)},fp); if(k>0.) g+=${IG(.5*e.w/e.km)}*(grNoiseD(GEO_ROT${t+1}*q/${IG(e.km)}+${IG(e.seed)}).yzw*GEO_ROT${t+1})*k; }`).join(`
  `)}
