// Ground radiance before aerial perspective: groundLight over groundSurface (see them for the arguments);
// in the far program (GEO_FAR) over the baked surface (and the ring cache, where the program reads it).
vec3 groundShade(vec3 n, vec3 V, vec3 s, float fp, float detail, float near, vec2 loc, vec3 east, vec3 north, float time, vec4 paint, float shadow, vec3 lamp){
#ifdef GEO_FAR
#ifdef GR_SURFACE_CACHE
  // The far chunks around the craft read the ring cache where its windows cover (en: the cache plane's east
  // and north through the sphere point, as the near chunks' vertices give it), the far bakes beyond: the near
  // and far chunks' border can lie inside the coarsest ring window, where the ring's texels are still finer
  // than the far windows' 24 m, and the two must not meet in a step.
  GroundSurface sf; float cw=surfaceCacheOn>.5?groundSurfaceRead(GEO_R_KM*1000.*vec2(dot(n,surfaceCacheEast),dot(n,surfaceCacheNorth)),fp,n,detail,sf):0.;
  if(cw<1.){ GroundSurface sp=groundSurfaceFar(n,fp); if(cw>0.) sf=groundSurfaceMix(sp,sf,cw,n); else sf=sp; }
  return groundLight(sf,n,V,s,fp,detail,near,loc,east,north,time,paint,shadow,lamp);
#else
  return groundLight(groundSurfaceFar(n,fp),n,V,s,fp,detail,near,loc,east,north,time,paint,shadow,lamp);
#endif
#else
  return groundLight(groundSurface(n,V,fp,detail,near,loc,east,north),n,V,s,fp,detail,near,loc,east,north,time,paint,shadow,lamp);
#endif
}
