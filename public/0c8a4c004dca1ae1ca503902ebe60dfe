// The cloud layer where a view ray crosses it (pc, km; dir: the ray): premultiplied radiance
// and cover. below: 1 when seen from under the layer (darker bases).
// cached: pc is where the view ray first crosses the deck, so the field may come from the cloud cache.
vec4 clShade(vec3 pc, vec3 dir, vec3 s, float fpKm, float below, bool cached){
  fpKm*=max(cloudFpScale,1.);
  geoBakeSet(fpKm*1000.);
  vec3 n=normalize(pc), p; float bias, clear, f;
  // From the cache (cloudCache.ts): the whole field, so the warp, weather and octaves are skipped here
  // (the clear zone is cheap and stays per pixel).
  float fc=-1e4;
#ifdef CL_CACHE
  if(cached) fc=clCacheAt(pc);
#endif
  bool hit=fc>CL_CACHE_NONE;
  if(hit){ clear=clClear(n); if(clear<=0.) return vec4(0.); f=fc; }
  else { clear=clBase(n,p,bias); if(clear<=0.) return vec4(0.); f=clField(n,p,bias,fpKm,0.); }
  // Grazing views (D1): toward the horizon the line of sight crosses the cells' sides, so
  // the gaps close and thin cloud turns opaque; the far deck reads as one sheet.
  float graze=1.-smoothstep(.03,.3,abs(dot(n,dir)));
  float fill=CL_GRAZE_FILL*graze;
  f+=fill;
  float d=clThick(f,clear), a=(1.-pow(max(0.,1.-clCover(d)),1.+CL_GRAZE_POW*graze))*cloudAmount;
  if(a<=.002) return vec4(0.);
  float mu=dot(n,s), day=smoothstep(-.1,.1,mu);
  vec3 sun=atmSunTransmittance(pc,s)/ATM_ZENITH_SUN*day*mix(vec3(1.),GR_TERM,GR_TERM_K*(1.-smoothstep(.02,.22,mu)));
  // Billows: the tops as a height field (thickness × CL_DEPTH); one tap toward the sun gives
  // their slope there (the warp is locally a shift, so the tap reuses this point's warp).
  vec3 st=s-n*mu; float sl=length(st), ns=mu;
  // The tap only changes the direct sunlight term: nothing to gain on the night side (day = 0)
  // or where the relief fades out completely (graze = 1).
  if(sl>1e-4&&day>0.&&graze<1.&&cloudTapOff<.5){
    float h=clamp(2.5*fpKm,CL_STEP.x,CL_STEP.y);
    vec3 tap=st*(h/sl);
    // The tap stays procedural (p + tap, the warp taken as a local shift; a cache hit skipped clBase, so p comes from
    // clWarp): the cache holds the field on the warped surface only, and the tap's point lies off it by up to ~0.1 km,
    // which the slope lighting magnifies under a low sun (7–9 % of pixels changed > 2 levels near the terminator when
    // it was read from the cache).
    if(hit) clWarp(n,p,bias);
    // Toward the horizon the billows are far below a pixel: their light averages out, so the
    // relief fades there (a shaded side would otherwise turn whole grazing bands dark).
    float ft=clField(normalize(n*GEO_R_KM+tap),p+tap,bias,fpKm,0.);
    float g=CL_RELIEF*(1.-graze)*(clThick(ft+fill,clear)-d)/h;
    ns=(mu-g*sl)*inversesqrt(1.+g*g);
  }
  // Sun-facing billows lit, far sides in their own shade (only the wrap's scattered light).
  float lit=clamp((ns+CL_WRAP)/(1.+CL_WRAP),0.,1.);
  lit*=lit*(3.-2.*lit);
  float skyScale=day*(.35+.65*grLum(sun));
  // Thick tops scatter the most sunlight back up; thin rims pass it (less direct, more sky).
  // A grazing view sees the sheet's tops, not its thin gaps: shade it as thick cloud.
  float ds=mix(d,1.,graze);
  vec3 light=sun*CL_DIRECT*(.1+.9*lit)*(.45+.55*ds)+GR_SKY*1.6*GR_TINT*skyScale*(.7+.3*ds)+.3*GR_NIGHT*GR_NIGHT_TINT;
  // From below: light through the cloud, dimmer where it is thicker; past full cover the
  // deeper field still varies, so an overcast keeps broad light and dark patches.
  light*=mix(1.,.8-.25*d-.35*clDeep(f,clear),below);
  // Silver lining: looking toward the sun, thin rims forward-scatter it.
  float fwd=max(dot(dir,s),0.); fwd*=fwd; fwd*=fwd; fwd*=fwd;
  // Thin edges facing the sun get twice that (the bright rim itself).
  light+=sun*CL_DIRECT*CL_SILVER*fwd*(1.-d)*(1.+(1.-d)*(1.-d));
  return vec4(CL_ALBEDO*light*a,a);
}
// Inside the deck (D1; written per frame by the flight view, 0 elsewhere): rgb = the cloud's
// diffuse radiance at the eye, a = how much of the far view it hides.
uniform vec4 cloudFog;
#ifdef CL_MARCH
// High tier (D1): the deck as a slab marched along the view ray, with sun shadow taps. The
// same density field (clBase/clField) and profile (clSlab); x in km, map basis.
uniform float cloudMarch; // view steps, 0 = the layer shading
// cloudJitter: per-frame offset of the step jitter with TAA, negative without TAA.
uniform float cloudJitter;
const float CL_MARCH_KM=60.;
// Extinction weight at x; h: height above the base, th: the column's thickness, deep: clDeep.
float clMarchAt(vec3 x, float fpKm, out float h, out float th, out float deep){
  float r=length(x); h=r-CL_R; th=0.; deep=0.;
  if(h<-.05||h>CL_DEPTH) return 0.;
  vec3 n=x/r, p; float bias, clear=clBase(n,p,bias);
  if(clear<=0.) return 0.;
  float f=clField(n,p,bias,fpKm,0.);
  th=clThick(f,clear); deep=clDeep(f,clear);
  return clSlab(th,h);
}
float clHG(float c, float g){ float k=1.+g*g-2.*g*c; return (1.-g*g)/(k*sqrt(k)); }
vec4 clMarch(vec3 o, vec3 d, vec3 s, float pixelAngle, float tGround){
