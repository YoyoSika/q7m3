    float resolved=0.;
    // The waves and the shore foam fade by the footprint's long axis: the callers cap fp's grazing stretch at 4×
    // (len·angle / max(¼, cos)), but seen from the pad the sea lies at cos ≈ .02–.1, where that
    // cap left 9 m waves drawn under 20 m pixels: horizontal moiré bands (yoyo 2026-11-07).
    float fpW=fp*max(1.,.25/max(abs(dot(n,V)),.01));
    if(near>0.){
      for(int i=0;i<3;i++){
        float L=GR_WAVE_L[i], w=grFade(L,fpW);
#ifdef GR_WATER_FX
        w*=grFxLevel;
#endif
        if(w<=0.) continue;
        vec2 drift=vec2(.8,.35)*(.45/L)*time*float(i+1);
        vec4 wv=grNoiseD(vec3(loc/L+drift,time*(.12+.08*float(i))));
        slopeW+=(east*wv.y+north*wv.z)*(GR_WAVE_H[i]/L)*w;
        resolved+=w*w*GR_WAVE_VAR[i];
      }
      // The swell: slow, rolling shoreward, its own lattice offset.
      for(int i=0;i<2;i++){
        float L=GR_SWELL_L[i], w=grFade(L,fpW);
#ifdef GR_WATER_FX
        w*=grFxLevel;
#endif
        if(w<=0.) continue;
        vec2 drift=vec2(.8,.35)*(1.2/L)*time;
        vec4 wv=grNoiseD(vec3(loc/L+drift+vec2(31.+7.*float(i)),time*.05+5.));
        slopeW+=(east*wv.y+north*wv.z)*(GR_SWELL_H[i]/L)*w;
        resolved+=w*w*GR_SWELL_VAR[i];
      }
      // Never below one facet's roughness: the wind scales only the unresolved share (a calm area's total
      // is down to a quarter of GR_WAVE_TOTAL), and the resolved octaves' full variance can exceed it near the
      // eye. A negative a2 made sqrt() NaN, which min() turns into the glint's cap on Apple GPUs: a pure
      // white sea from the shore out to a distance around the eye (yoyo, iPhone/iPad 2026-11-17).
      a2=max(a2-resolved,GR_A0);
    }
    // Foam: a thin line along the waterline that pulses shoreward, averaged by footprint.
    float off=max(0.,-land)/GR_LAND_M;
    foam=1.-smoothstep(1.,5.+fpW,off);
    if(foam>0.){
      // The pulse (5.7 m across the shore) fades to its mean by the footprint, as the noise below.
      float pulse=grFade(5.7,fpW);
      foam*=.55+(pulse>0.?.45*pulse*sin(time*1.2-off*1.1+4.*geoNoise(q/.05)):0.);
      float nearFoam=near*grFade(1.5,fpW);
      if(nearFoam>0.) foam*=mix(.6,smoothstep(-.3,.4,grNoiseD(vec3(loc/1.5,time*.2)).x),nearFoam);
      else foam*=.6;
    }
    // A breaker line offshore (~12–26 m out, wandering), fragmented and rolling shoreward;
    // skipped where even its nearest possible position is many widths away (exp < 1e-13). Its width keeps
    // the isotropic fp: with the long axis the open sea (250 m out in the cache) would enter it again.
    float bd=max(0.,max(off-25.,11.-off));
    if(bd*bd<30.*(5.+fp*fp)){
      float bo=off-(18.+7.*geoNoise(q/.15+9.));
      float brk=exp(-bo*bo/(5.+fp*fp))*(.45+.55*sin(time*.9-off*.35))*smoothstep(-.3,.35,geoNoise(q/.04+vec3(time*.03,0.,0.)+13.));
      foam=max(foam,.7*brk);
    }
    foam*=min(1.,5./max(fpW,1e-3))*(1.-polar);
  }
#ifdef GR_WATER_FX
  // Wake and splash foam (every tier): the floating craft's, from the simulation's water state.
  if(water>0.&&grFxFoam>0.) foam=max(foam,grFxFoam*(1.-polar));
#endif
  vec3 skyL=GR_SKY*mix(GR_TINT,vec3(grLum(GR_TINT)),.6*shade)*skyScale;
#if defined(GEO_TERRAIN)&&!defined(GEO_FAR)
  // High mountains (the detail tile's horizon map, tileHorizon.ts): the peaks' cast shadows on the
  // direct sun, and the sky they hide from a valley floor on its light (not in the far program: its
  // mountains' shading is baked, and the horizon map belongs to the near tile variants).
  tileHorizon(tFromMap(n),tFromMap(s),fp);
  shadow*=tileHorizonLit; skyL*=tileHorizonSky;
#endif
  vec3 light=floorL+sun*GR_DIRECT*max(dot(N,s),0.)*shadow+skyL+lamp;
  vec3 c=albedo*light;
  if(water>0.){
    vec3 Nw=grTilt(n,slopeW);
#ifdef GR_WATER_FX
    if(waterFog.a>0.&&dot(n,V)<0.){
      // From below (the eye under the sea): the sky through Snell's window, the cone of rays that
      // leave the water (the critical angle about the wave normal, its rim softened), and total
      // internal reflection outside it, which mirrors the water body (the fog's colour).
      vec3 t=refract(-V,-Nw,1.333);
      if(dot(t,t)<.5) t=n;
      vec3 thru=grSky(t,n,s,skyScale,a2,detail)*(1.-grFresnel(max(dot(t,Nw),0.)))
        +sun*shadow*GR_DIRECT*GR_GLINT_GAIN*8.*smoothstep(.999,.9998,dot(t,s));
      return mix(c,mix(waterFog.rgb,thru,smoothstep(GR_SNELL.x,GR_SNELL.y,dot(-Nw,V))),water);
    }
#endif
    float nv=max(dot(Nw,V),1e-3), nl=max(dot(Nw,s),0.);
    vec3 H=normalize(V+s);
    float F=grFresnel(nv);
    vec3 r=reflect(-V,Nw);
    vec3 sky=grSky(r,n,s,skyScale,a2,detail);
    vec3 lf=floorL+sun*GR_DIRECT*max(dot(n,s),0.)*shadow+skyL+lamp;
    // max, then min: Metal's min(cap, NaN) is the cap, so one NaN factor (H when V = -s) was the brightest glint.
    vec3 glint=min(vec3(GR_GLINT),max(vec3(0.),3.14159265*grGGX(max(dot(Nw,H),0.),a2)*grVis(nl,nv,a2)*grFresnel(max(dot(H,V),0.))*nl*GR_GLINT_GAIN*GR_DIRECT*sun*shadow));
    vec3 wet=albedo*(1.-F)*lf+F*sky+glint;
    c=mix(c,wet,water);
    c=mix(c,.75*lf,foam*water);
  }
  if(paint.a>0.){
    vec3 lf=floorL+sun*GR_DIRECT*max(dot(n,s),0.)*shadow+skyL+lamp;
    c=mix(c,paint.rgb*lf,paint.a);
  }
  // City lights on the night side (full detail only): switched on as the sun sets.
  if(detail>0.&&mu<.05&&water<1.){
    float dens=sf.city;
    if(dens<0.){ float dl=grCityLand(land,polar); dens=dl>0.?dl*grCityStatic(q,sf.relief):0.; }
    c+=GR_CITY*GR_CITY_TINT*grCityLights(q,dens,fp)*(1.-smoothstep(-.1,.04,mu))*(1.-water);
  }
  return c;
}
#ifdef GR_SURFACE_CACHE
${pK}
// The cached surface at cache-plane en (m) for a pixel of footprint fp at radial n (the cache's
// encoding is earthSurfaceCache.ts). From the level the footprint picks, up to three levels each take
// what the finer ones left of the pixel, scaled by the level's window-edge fade and its fade-in, so a
// window's edge, a level still rendering and a level switched off all hand over to the next coarser
// level without a seam; what no level covers is the returned weight's rest (shade it procedurally).
float groundSurfaceRead(vec2 en, float fp, vec3 n, float detail, out GroundSurface sf){
  float lamR=log2(fp/surfaceCacheInfo.y)*surfaceCacheInfo.w, last=surfaceCacheInfo.x-1.;
  // Past the coarsest level the far bakes or the procedural ground take over within half a level. Finer than
  // the finest level: the procedural program goes procedural within a level (a texel magnified past 2× is a
  // blur); the cache-only program (GEO_FAR) keeps the finest level magnified — the ground has no detail below
  // its 0.7 m octave (groundLight adds that one per pixel), so the texel holds all there is.
#ifdef GEO_FAR
  float tail=1.-clamp((lamR-last)*2.,0.,1.);
#else
  float tail=(1.-clamp((lamR-last)*2.,0.,1.))*smoothstep(-1.,0.,lamR);
#endif
  if(tail<=0.) return 0.;
  float lam=max(0.,lamR);
  int c=int(min(floor(lam),last));
  float f=float(c)<last?lam-float(c):0.;
  // Only the two levels the footprint falls between: a pixel outside their windows (or over a level still
  // rendering or off) is procedural, never a coarser level's texel — that is a visible blur, not a saving.
  float w0=(1.-f)*surfaceCacheEdge(c,en)*surfaceCacheLevel[c].w, w1=0., total=w0;
  vec4 A=vec4(0.), B=vec4(0.);
  if(w0>0.){ vec4 a, b; surfaceCacheFetch(c,en,a,b); A=a*w0; B=b*w0; }
#ifdef GEO_FAR
  // The cache-only program has no procedural share: level c+1 takes all that level c left (its own share f
  // and what c's window or fade-in lacks), and what the two lack the coarser levels fill in turn (their windows
  // reach farther), before the far bakes' windows at 24 m and up. Continuous in the footprint: were level c+1
  // given only f, a pixel outside c's window would drop from the next level to the one after as f reaches 0
  // (a seam along a constant-footprint curve).
  float f1=float(c)<last?1.-w0:0.;
#else
  float f1=f;
#endif
  if(f1>0.){
    w1=f1*surfaceCacheEdge(c+1,en)*surfaceCacheLevel[c+1].w;
    if(w1>0.){ vec4 a, b; surfaceCacheFetch(c+1,en,a,b); A+=a*w1; B+=b*w1; total+=w1; }
  }
#ifdef GEO_FAR
  for(int k=c+2;k<=int(last);k++){
    if(total>=.998) break;
    float wk=(1.-total)*surfaceCacheEdge(k,en)*surfaceCacheLevel[k].w;
    if(wk>0.){ vec4 a, b; surfaceCacheFetch(k,en,a,b); A+=a*wk; B+=b*wk; total+=wk; }
  }
#endif
  if(total<=0.) return 0.;
  A/=total; B/=total;
  vec3 E, N; surfaceCacheTangent(n,E,N);
  // A.a = (1 + water − city) / 2: ½ (dry land, no lights) is a byte 127 or 128, so a step of 1/255 either
  // side still reads 0 — a land pixel must not enter the water shading at 0.4 %.
  float wc=A.a*2.-1.;
  sf.albedo=pow(A.rgb,vec3(2.2)); sf.slope=E*B.x+N*B.y;
  sf.water=max(0.,(wc*255.-1.)/254.); sf.city=max(0.,(-wc*255.-1.)/254.); sf.polar=0.; sf.land=B.w*1e-4; sf.relief=0.; sf.fine=B.z;
  sf.a2=GR_A0+GR_WAVE_TOTAL;
  if(detail>0.&&sf.water>0.) sf.a2=GR_A0+(sf.a2-GR_A0)*(1.+geoWindAny(n,n*GEO_R_KM));
  return total*tail;
}
// A procedural surface a and the cached one b at weight w (the cache's fade-in or window rest).
GroundSurface groundSurfaceMix(GroundSurface a, GroundSurface b, float w, vec3 n){
  if(a.city<0.){ float dl=grCityLand(a.land,a.polar); a.city=dl>0.?dl*grCityStatic(n*GEO_R_KM,a.relief):0.; }
  GroundSurface s;
  s.albedo=mix(a.albedo,b.albedo,w); s.slope=mix(a.slope,b.slope,w);
  s.water=mix(a.water,b.water,w); s.polar=mix(a.polar,b.polar,w); s.land=mix(a.land,b.land,w); s.relief=mix(a.relief,b.relief,w);
  s.a2=mix(a.a2,b.a2,w); s.city=mix(a.city,b.city,w); s.fine=mix(a.fine,b.fine,w);
  return s;
}
