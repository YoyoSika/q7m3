  // the zone is a cap, convex along the arc the run's directions trace, so its two ends decide it.
  if(max(geoSiteKm(normalize(o+d*t0)),geoSiteKm(normalize(o+d*(t0+len))))>=CL_CLEAR_KM){
  // Steps grow quadratically (dense near the eye, where the deck fills the most pixels).
  // Interleaved gradient noise offsets them per pixel; with TAA the offset turns every
  // frame (golden ratio), so the accumulation averages the slices away. Without TAA nothing
  // averages it: more steps, and only a small offset around the middle (fine slices, no sand).
  float ign=fract(52.9829189*fract(dot(gl_FragCoord.xy,vec2(.06711056,.00583715))));
