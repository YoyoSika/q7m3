  // What the finer level lacks (outside its window, off, still rendering) the coarser ones fill in turn:
  // there is no procedural share here, and the cube's level 0 is far coarser than any window.
  float need=1., w=0.;
  if(k1>=lo&&k1<=hi){ w=geoWinAt(k1,n,a,b)*f; if(w>0.){ A+=a*w; B+=b*w; total+=w; need-=w; } }
  for(int k=min(k1-1,hi);k>=lo;k--){
