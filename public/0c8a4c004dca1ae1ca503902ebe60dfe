      // also screens the scattered light, so bases darken where the cloud is thick.
      float od=CL_SIGMA_KM*(.35*clMarchAt(x+s*.18,fp+.4,hs,ts,td)+.55*clMarchAt(x+s*.6,fp+.8,hs,ts,td));
      // Deeper field = denser column: an overcast base keeps broad light and dark patches.
      float above=CL_SIGMA_KM*max(0.,th*CL_DEPTH-h)*(.35+.65*th)*(.6+.8*deep);
      float hn=clamp(h/CL_DEPTH,0.,1.);
