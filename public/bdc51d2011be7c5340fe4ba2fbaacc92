// The baked far surface's tangent frame at n (the aux cube's slope is stored in it; bake and read agree):
// E east (the polar axis is y), N north; at the poles a fixed frame.
void grTangent(vec3 n, out vec3 E, out vec3 N){
  E=length(n.xz)>1e-4?normalize(vec3(n.z,0.,-n.x)):vec3(1.,0.,0.);
