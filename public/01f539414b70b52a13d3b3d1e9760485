// City lights (linear radiance before the night factor): towns and cities as soft points on
// inhabited lowland near coasts, few in the deserts (geoArid from surfaceFrom); each scale fades to its
// mean glow once cells approach the footprint.
float grCityScale(vec3 q, float cell, float radius, float chance, float dens, float fpKm){
  float mean=chance*dens*3.14159*radius*radius/(cell*cell);
  float blend=smoothstep(.12*cell,.45*cell,fpKm);
  if(blend>=1.) return mean;
  vec3 c=q/cell; ivec3 ci=ivec3(floor(c));
  float h=geoLattice(ci+ivec3(7,3,1)), lit=0.;
  if(h<chance*dens){
    vec3 off=vec3(geoLattice(ci+ivec3(13,0,0)),geoLattice(ci+ivec3(0,17,0)),geoLattice(ci+ivec3(0,0,19)))*.6+.2;
    vec3 centre=normalize((floor(c)+off)*cell)*GEO_R_KM;
    float r=radius*(.45+.9*h/(chance*dens)), s2=r*r+.25*fpKm*fpKm, d=length(q-centre);
