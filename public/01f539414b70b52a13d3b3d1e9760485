  if(detail>0.&&land>0.&&land<.0012)
    landC+=(grOct(.00028,q/.045+21.,grFade(45.,fp))+grOct(.00012,q/.014+23.,grFade(14.,fp)))*smoothstep(.00005,.0003,land);
  vec3 albedo=pow(surfaceFrom(n,landC,relief,blur),vec3(2.2));
  float grass=smoothstep(.00025-sb,.0008+sb,landC);
  // The ice: surfaceFrom's own value on the open sea, else with the land field (no second height fetch).
  // blur*100 is surfaceFrom's own footprint (km): the same key, so its ice-edge noise is not evaluated again.
  float polar=geoSeaPolar>=0.?geoSeaPolar:geoPolarAt(n,land,blur*100.);
  // Ice caps lie over ocean in the land field but are not water.
  float sea=1.-smoothstep(-(2e-6+sb),2e-6+sb,land), water=sea*(1.-polar);
  float a2=GR_A0+GR_WAVE_TOTAL;
  if(detail>0.){
    float nearW=near*(1.-polar);
    // Land only: on sea pixels (ice-covered ones included) keep below would discard all of it;
    // wholly under ice (keep below is 1) the land detail would be discarded too.
    if(sea<1.&&polar<1.){
      // Field patches (260 m cells, warped), meadow and scrub tones; all fade to their mean by footprint.
      // Every octave below is skipped once its fade reaches 0 (exactly its mean): from orbit
      // and most of the ascent none of them is evaluated. Seen from a few kilometres up (footprints
      // past 6 m) they fade at a larger footprint fd, 2× the pixel's by 18 m (1.5× for the fields):
      // there the small octaves read as speckle (yoyo 2026-11-02: the far ground keeps what shows).
      float lod=smoothstep(6.,18.,fp), fd=fp*(1.+lod);
      float fpc=fp/260., farm=0., cell=.5, inField=0.;
      // No fields or green scrub in the deserts (geoArid: the climate's desert cover from surfaceFrom).
      float farmK=(1.-smoothstep(.12,.35,fpc*(1.+.5*lod)))*(1.-smoothstep(.1,.35,relief))*(1.-geoArid);
      // The farmland mask first (7 km, geoFarm: baked where the bake is on): outside it the cells
      // (warp and lattice) add nothing (inField 0), so they are not evaluated there.
      if(farmK>0.) farm=smoothstep(-.15,.35,geoFarm(n,q))*farmK;
      if(farm>0.){
        vec3 warp=geoNoise3(q/.9);
        vec3 fc=q/.26+.8*warp, fe=min(fract(fc),1.-fract(fc));
        float edge=min(min(fe.x,fe.y),fe.z);
        cell=geoLattice(ivec3(floor(fc))+ivec3(11,23,5));
        inField=farm*smoothstep(.5*fpc,.5*fpc+.035,edge);
      }
      float field=(cell*2.-1.)*inField;
      // Scrub and soil cover fade to their mean coverage (not to none), so grass seen at a
      // grazing angle from the pad has the same average tone as from 1 km up.
      float scrubK=grFade(90.,fd), scrub=.14*(1.-scrubK);
      // Deserts take no scrub (the factor below): its noise is skipped there.
      if(scrubK>0.&&geoArid<1.) scrub+=smoothstep(.25,.65,geoNoise(q/.38+7.)+grOct(.45,q/.11+1.3,grFade(110.,fd)))*scrubK;
      scrub*=(1.-.8*farm)*(1.-geoArid);
      float k45=grFade(45.,fd), k17=grFade(17.,fd);
      // The 45 m and 17 m octaves shade both the tone and the normal: one grNoiseD each gives the value and the slope.
      vec4 o45=k45>0.?grNoiseD(q/.045+2.):vec4(0.), o17=k17>0.?grNoiseD(q/.017+4.):vec4(0.);
      float m=grOct(.5,q/.12,grFade(120.,fd))+.3*o45.x*k45+.2*o17.x*k17;
      vec3 slope=o45.yzw*(1.2/45.)*k45+o17.yzw*(.35/17.)*k17;
      // Bare ground by slope: scree and rock wall where the drawn ground is steep, gravel on gentle
      // bare ground (geoBare). Their grain is the metre octaves below, stronger (gain per octave).
      vec3 ridge=grRidges(n,q,land,fp);
      vec2 bare=grSlopeClass(length(ridge),m,fp)*(1.-polar);
      float gravel=geoBare*(1.-bare.x)*(1.-bare.y)*(1.-smoothstep(GR_SLOPE_K.y,GR_SLOPE_K.z,fp));
      vec3 gain=1.+bare.y*vec3(1.2,.8,.4)+bare.x*vec3(.4,.9,1.)+gravel*vec3(0.,.6,.7);
      float mN=0.;
#ifdef GR_SURFACE_BAKE
      // The bake (GR_SURFACE_BAKE) leaves the 0.7 m octave to groundLight (its gain in sf.fine): a cache
      // texel cannot hold it, and the footprint that fades it is the pixel's, not the level's.
      float fineW=0.;
      if(nearW>0.){
        vec3 p3=vec3(loc,0.);
        vec4 m1=grNoiseD(p3/5.5+vec3(0,0,.3)), m2=grNoiseD(p3/2.+vec3(0,0,.6));
        float f1=grFade(5.5,fp)*nearW*gain.x, f2=grFade(2.,fp)*nearW*gain.y;
        mN+=.25*m1.x*f1+.18*m2.x*f2;
        vec2 g2=m1.yz*(.2/5.5)*f1+m2.yz*(.07/2.)*f2;
        slope+=east*g2.x+north*g2.y;
        fineW+=nearW;
      }
      float near3=(1.-near)*(1.-polar);
      if(near3>0.&&grFade(5.5,fp)>0.){
        vec4 m1=grNoiseDM(grNear3P/5.5+grNearOff[0],4095), m2=grNoiseDM(grNear3P/2.+grNearOff[1],4095);
        float f1=grFade(5.5,fp)*near3*gain.x, f2=grFade(2.,fp)*near3*gain.y;
        mN+=.25*m1.x*f1+.18*m2.x*f2;
        slope+=m1.yzw*(.2/5.5)*f1+m2.yzw*(.07/2.)*f2;
        fineW+=near3;
      }
#else
      if(nearW>0.){
        vec3 p3=vec3(loc,0.);
        vec4 m1=grNoiseD(p3/5.5+vec3(0,0,.3)), m2=grNoiseD(p3/2.+vec3(0,0,.6)), m3=grNoiseD(p3/.7+vec3(0,0,.9));
        float f1=grFade(5.5,fp)*nearW*gain.x, f2=grFade(2.,fp)*nearW*gain.y, f3=grFade(.7,fp)*nearW*gain.z;
        mN+=.25*m1.x*f1+.18*m2.x*f2+.12*m3.x*f3;
        vec2 g2=m1.yz*(.2/5.5)*f1+m2.yz*(.07/2.)*f2+m3.yz*(.025/.7)*f3;
        slope+=east*g2.x+north*g2.y;
      }
#ifdef GR_NEAR3
      // The same octaves in 3D on the Earth patch (planet-fixed, so steep slopes are not stretched).
      float near3=(1.-near)*(1.-polar);
      if(near3>0.&&grFade(5.5,fp)>0.){
        vec4 m1=grNoiseDM(grNear3P/5.5+grNearOff[0],4095), m2=grNoiseDM(grNear3P/2.+grNearOff[1],4095), m3=grNoiseDM(grNear3P/.7+grNearOff[2],4095);
        float f1=grFade(5.5,fp)*near3*gain.x, f2=grFade(2.,fp)*near3*gain.y, f3=grFade(.7,fp)*near3*gain.z;
        mN+=.25*m1.x*f1+.18*m2.x*f2+.12*m3.x*f3;
        slope+=m1.yzw*(.2/5.5)*f1+m2.yzw*(.07/2.)*f2+m3.yzw*(.025/.7)*f3;
      }
#endif
#endif
      m+=mN;
      // Mid-scale variation (C2, 50–300 m, what the pad and low ascent views resolve):
      // light/dark patches, a dry-straw ↔ lush-green hue drift and bare-earth scars.
      // Zero-mean tone and hue; the soil patches are rare enough to leave the far colour.
      // Near-ground only (pixel footprint under ~6 m, i.e. the pad and the low ascent): from
      // high up the same octaves read as a dense speckle, so they fade out there.
      float nearK=1.-smoothstep(1.5,6.,fp);
      float k220=grFade(220.,fp)*nearK, midV=0., midH=0., soil=.05*(1.-grFade(110.,fp)*nearK)*(1.-.7*farm);
      if(k220>0.){
        float k30=grFade(30.,fp)*nearK;
        midV=grOct(1.,q/.15+47.,grFade(150.,fp)*nearK)+grOct(.5,q/.06+49.,grFade(60.,fp)*nearK)+grOct(.4,q/.03+57.,k30);
        midH=geoNoise(q/.22+41.)*k220+grOct(.6,q/.08+43.,grFade(80.,fp)*nearK)+grOct(.35,q/.028+59.,k30);
        soil+=smoothstep(.5,.8,geoNoise(q/.11+53.)+grOct(.35,q/.035+55.,grFade(35.,fp)))*grFade(110.,fp)*nearK*(1.-.7*farm);
      }
      // Grass: tone, fields (a few ripen to straw), scrub darker and greener.
      vec3 gl=albedo*(1.+(.10+.04*nearK)*m+(.13+.05*nearK)*field+.28*midV)*(1.+midH*vec3(.2,.06,-.16));
      gl=mix(gl,GR_SOIL*(1.+.25*m),soil*.5);
      gl=mix(gl,gl*vec3(1.22,1.08,.7),smoothstep(.86,.93,cell)*inField*.7);
      gl=mix(gl,gl*vec3(.82,.95,.8),smoothstep(.1,.02,cell)*inField);
      gl=mix(gl,gl*vec3(.6,.78,.55),scrub*.85);
      if(bare.x+bare.y>0.){
        // Rock strata: layered tone, and ledges (the face alternately steeper and gentler).
        float st=0.;
#ifdef GEO_TERRAIN
        if(bare.y>0.&&terrainInfo.x>0.){ st=grStrataAt(n,V,ridge,q,fp); ridge*=1.+.4*bare.y*st; }
#endif
        gl=grBare(gl,bare,mN,st);
      }
      // Sand: ripples and grain; darker wet sand just above the waterline. Inland (grass 1) it is not drawn.
      vec3 sd=gl;
      if(grass<1.){
        float sm=grOct(.07,q/.017+6.,k17)+.05*m;
        sd=albedo*(1.+sm);
        float wet=1.-smoothstep(0.,.00005+blur,land);
        sd*=mix(1.,.62,wet*(1.-grass));
        // Drift line at the high-water mark (~12 m inland): broken streaks of dark wrack.
        float hw=(land-.00012)/.00002;
        float k6=grFade(6.,fp);
        if(k6>0.&&hw*hw<24.) sd*=1.-.28*exp(-hw*hw)*smoothstep(-.1,.4,geoNoise(q/.025+31.))*k6;
      }
      // Land detail only on land (not on the shore band's sea share), never on ice.
      float keep=max(polar,sea);
      albedo=mix(mix(sd,gl,grass),albedo,keep);
      // Mountain ridges (L6): the relief's gradient as a normal, never on water or ice.
      slope+=ridge;
      sf.slope=slope*(1.-keep);
#ifdef GR_SURFACE_BAKE
      sf.fine=fineW*gain.z*(1.-keep);
#endif
    }
    if(water>0.){
      // Wind: calmer and rougher sea areas (30–85 km) vary the unresolved wave slopes, so the
      // glitter seen from orbit is patchy rather than a round spot; the mean matches the mirror.
      a2=GR_A0+(a2-GR_A0)*(1.+geoWind(n,q));
      // Shallows: the sandy bottom shows through clear water near the beach.
      float off=max(0.,-land)/GR_LAND_M;
      albedo=mix(albedo,GR_SAND*vec3(.6,.88,.84),.55*exp(-off/12.)*(1.-polar));
      albedo*=1.+grOct(.08,q/.08+3.,(1.-smoothstep(.002,.006,-land))*grFade(80.,fp));
    }
  }
#ifdef GEO_TERRAIN
  // Without detail the real relief still shades (the displaced far globe's slopes); not on water or ice.
  // The low tier's one layer of bare ground: scree and rock by slope, the strata as a tone and, on
  // the Earth patch, the 2 m octave as their grain.
  if(detail<=0.&&sea<1.){
    float k=geoDataK(n);
    if(k>0.){
      vec3 ds=grDataSlope(n,fp)*k*(1.-max(polar,sea));
      vec2 bare=grSlopeClass(length(ds),0.,fp)*grass;
      if(bare.x+bare.y>0.){
        float t=0., st=bare.y>0.?grStrataAt(n,V,ds,q,fp):0.;
#ifdef GR_NEAR3
        float f2=grFade(2.,fp)*(1.-near);
        if(f2>0.){ vec4 o=grNoiseDM(grNear3P/2.+grNearOff[1],4095); t=.3*o.x*f2; ds+=o.yzw*(.12/2.)*f2*(bare.x+bare.y); }
#endif
        albedo=grBare(albedo,bare,t,st);
      }
      sf.slope=ds;
    }
  }
#endif
  sf.albedo=albedo; sf.water=water; sf.polar=polar; sf.land=land; sf.relief=relief; sf.a2=a2;
  return sf;
}
#else
// The far program (GEO_FAR): the surface half from the baked cubes (geoAlbedo.ts), one trilinear read each,
// whatever the footprint (a pixel finer than a level-0 texel reads a magnified texel). The land field comes
// back over ±GEO_AUX_LAND (saturated farther from a coast, where only its sign matters), the slope in the
// tangent frame, the city density ready for grCityLights; the sea wind stays per pixel (one bake read).
GroundSurface groundSurfaceFar(vec3 n, float fp){
  GroundSurface sf;
  geoBakeSet(fp);
  // The detail windows where they hold the pixel's footprint first: the nadir levels finer than the tile's static
  // window, then that window (the whole Himalaya tile), then the coarser nadir levels, then the cube for the rest.
  vec2 tab; float tedge, ts=geoTileAt(n,tab,tedge);
  int kt=ts>0.?geoTileLevel(n,ts):0;
  vec4 gs, ax; float ww=geoWinRead(n,fp,kt,64,gs,ax);
  if(ww<1.&&ts>0.){ vec4 ta, tb; float wt=geoTileRead(fp,ts,tab,tedge,ta,tb)*(1.-ww); if(wt>0.){ gs+=ta*wt; ax+=tb*wt; ww+=wt; } }
  if(ww<1.&&kt>0){ vec4 wa, wb; float w2=geoWinRead(n,fp,0,kt-1,wa,wb)*(1.-ww); if(w2>0.){ gs+=wa*w2; ax+=wb*w2; ww+=w2; } }
  if(ww<1.){ gs+=geoAlbedoAt(n,fp)*(1.-ww); ax+=geoAlbedoAuxAt(n,fp)*(1.-ww); }
  float land=(ax.a*2.-1.)*GEO_AUX_LAND, polar=gs.a, blur=fp*GR_LAND_M;
  float sea=1.-smoothstep(-(2e-6+blur),2e-6+blur,land), water=sea*(1.-polar);
  vec2 c=ax.gb*2.-1.; vec2 sl=c/max(1.-abs(c),1e-3);
  vec3 E, N; grTangent(n,E,N);
  sf.albedo=pow(gs.rgb,vec3(2.2)); sf.slope=(E*sl.x+N*sl.y)*(1.-max(polar,sea));
  sf.water=water; sf.polar=polar; sf.land=land; sf.relief=0.; sf.city=ax.r; sf.fine=0.;
  float a2=GR_A0+GR_WAVE_TOTAL;
  if(water>0.) a2=GR_A0+(a2-GR_A0)*(1.+geoWind(n,n*GEO_R_KM));
  sf.a2=a2;
  return sf;
}
#endif
/*
 * The lit half: radiance before aerial perspective. sf: the surface (groundSurface or the cache);
 * n, V, fp, detail, near, loc, east, north as groundSurface's; s: toward the sun; paint: man-made
 * albedo (linear) and its coverage; shadow: factor on direct sunlight; lamp: irradiance from a local
 * light (the engine flame, L7), diffuse only.
 */
vec3 groundLight(GroundSurface sf, vec3 n, vec3 V, vec3 s, float fp, float detail, float near, vec2 loc, vec3 east, vec3 north, float time, vec4 paint, float shadow, vec3 lamp){
  vec3 q=n*GEO_R_KM;
  vec3 albedo=sf.albedo, slope=sf.slope;
  float water=sf.water, polar=sf.polar, land=sf.land, a2=sf.a2;
  geoBakeSet(fp);
  float day=daylight(n,s), mu=dot(n,s);
  float band=GR_TERM_K*(1.-smoothstep(.02,.22,mu));
  vec3 sun=atmSunTransmittance(n*ATM_R,s)/ATM_ZENITH_SUN*day*mix(vec3(1.),GR_TERM,band);
  float skyScale=day*(.35+.65*grLum(sun));
  // Cloud shadow (L6): the layer's cover where the sun ray crosses it, softened by 0.8 km
  // (the sub-kilometre fraying is left out: cheaper, and a shadow is softer than its cloud).
  // The cloud also hides part of the blue sky overhead and sends grey light down instead.
  float shade=0.;
  if(cloudAmount>0.&&mu>0.){
    vec3 toCloud=normalize(n*GEO_R_KM+s*(CL_H/max(mu,.15)));
#ifdef GEO_BAKED
    // Baked (geoBake.ts F): the same cover, the footprint by its mip chain; the sun only moves the lookup.
    if(geoBakeOn>0.) shade=CL_SHADOW*cloudAmount*geoCloudShadow(toCloud,fp*.001);
    else
#endif
    {
    geoBakeSet(fp+800.);
    // The shadow drops octaves that would add under a tenth of their weight (a shadow is softer than its cloud; yoyo's rule 2026-10-30: changes under 5% of pixels are fine).
    shade=CL_SHADOW*cloudAmount*clDensity(toCloud,fp*.001+.8,.1);
    geoBakeSet(fp);
    }
  }
  sun*=1.-shade;
  vec3 floorL=GR_NIGHT*mix(GR_NIGHT_TINT,vec3(1.),day)+GR_TWILIGHT*GR_TERM*smoothstep(-.12,-.02,mu)*(1.-smoothstep(-.02,.1,mu));
#ifdef GR_SURFACE_CACHE
  // The 0.7 m octave the cache left out (sf.fine: its gain there, 0 for a procedural surface), faded by
  // the pixel's own footprint: its slope as the bake would have added it, its tone as the grass takes it
  // (GR_FINE_TONE; sand and scree take it a little less or more, under a per cent of the pixel either way).
  if(sf.fine>0.&&detail>0.&&paint.a<1.){
    float f3=grFade(.7,fp);
    if(f3>0.){
      f3*=sf.fine;
#ifdef GR_NEAR3
      vec4 m3=grNoiseDM(grNear3P/.7+grNearOff[2],4095);
#else
      vec4 m3=grNoiseD(vec3(loc,0.)/.7+vec3(0,0,.9));
#endif
      slope+=m3.yzw*(.025/.7)*f3;
      albedo*=1.+GR_FINE_TONE*.12*m3.x*f3;
    }
  }
#endif
  vec3 N=dot(slope,slope)>0.?grTilt(n,slope):n;
  vec3 slopeW=vec3(0.);
  float foam=0.;
  if(detail>0.&&water>0.){
    // Waves on the launch patch (animated, site metres); smaller octaves than the footprint become roughness.
    float resolved=0.;
    if(near>0.){
      // The waves fade by the footprint's long axis: the callers cap fp's grazing stretch at 4×
      // (len·angle / max(¼, cos)), but seen from the pad the sea lies at cos ≈ .02–.1, where that
      // cap left 9 m waves drawn under 20 m pixels: horizontal moiré bands (yoyo 2026-11-07).
      float fpW=fp*max(1.,.25/max(abs(dot(n,V)),.01));
      for(int i=0;i<3;i++){
        float L=GR_WAVE_L[i], w=grFade(L,fpW);
#ifdef GR_WATER_FX
        w*=grFxLevel;
#endif
        if(w<=0.) continue;
        vec2 drift=vec2(.8,.35)*(.45/L)*time*float(i+1);
        vec4 wv=grNoiseD(vec3(loc/L+drift,time*(.12+.08*float(i))));
        slopeW+=(east*wv.y+north*wv.z)*(GR_WAVE_H[i]/L)*w;
        resolved+=w*w*GR_WAVE_VAR[i];
      }
      // The swell: slow, rolling shoreward, its own lattice offset.
      for(int i=0;i<2;i++){
        float L=GR_SWELL_L[i], w=grFade(L,fpW);
#ifdef GR_WATER_FX
        w*=grFxLevel;
#endif
        if(w<=0.) continue;
        vec2 drift=vec2(.8,.35)*(1.2/L)*time;
        vec4 wv=grNoiseD(vec3(loc/L+drift+vec2(31.+7.*float(i)),time*.05+5.));
        slopeW+=(east*wv.y+north*wv.z)*(GR_SWELL_H[i]/L)*w;
        resolved+=w*w*GR_SWELL_VAR[i];
      }
      a2-=resolved;
    }
    // Foam: a thin line along the waterline that pulses shoreward, averaged by footprint.
    float off=max(0.,-land)/GR_LAND_M;
    foam=1.-smoothstep(1.,5.+fp,off);
    if(foam>0.){
      foam*=.55+.45*sin(time*1.2-off*1.1+4.*geoNoise(q/.05));
      float nearFoam=near*grFade(1.5,fp);
      if(nearFoam>0.) foam*=mix(.6,smoothstep(-.3,.4,grNoiseD(vec3(loc/1.5,time*.2)).x),nearFoam);
      else foam*=.6;
    }
    // A breaker line offshore (~12–26 m out, wandering), fragmented and rolling shoreward;
    // skipped where even its nearest possible position is many widths away (exp < 1e-13).
    float bd=max(0.,max(off-25.,11.-off));
    if(bd*bd<30.*(5.+fp*fp)){
      float bo=off-(18.+7.*geoNoise(q/.15+9.));
      float brk=exp(-bo*bo/(5.+fp*fp))*(.45+.55*sin(time*.9-off*.35))*smoothstep(-.3,.35,geoNoise(q/.04+vec3(time*.03,0.,0.)+13.));
      foam=max(foam,.7*brk);
    }
    foam*=min(1.,5./max(fp,1e-3))*(1.-polar);
  }
#ifdef GR_WATER_FX
  // Wake and splash foam (every tier): the floating craft's, from the simulation's water state.
  if(water>0.&&grFxFoam>0.) foam=max(foam,grFxFoam*(1.-polar));
#endif
  vec3 skyL=GR_SKY*mix(GR_TINT,vec3(grLum(GR_TINT)),.6*shade)*skyScale;
#if defined(GEO_TERRAIN)&&!defined(GEO_FAR)
  // High mountains (the detail tile's horizon map, tileHorizon.ts): the peaks' cast shadows on the
  // direct sun, and the sky they hide from a valley floor on its light (not in the far program: its
  // mountains' shading is baked, and the horizon map belongs to the near tile variants).
  tileHorizon(tFromMap(n),tFromMap(s),fp);
  shadow*=tileHorizonLit; skyL*=tileHorizonSky;
#endif
  vec3 light=floorL+sun*GR_DIRECT*max(dot(N,s),0.)*shadow+skyL+lamp;
  vec3 c=albedo*light;
  if(water>0.){
    vec3 Nw=grTilt(n,slopeW);
#ifdef GR_WATER_FX
    if(waterFog.a>0.&&dot(n,V)<0.){
      // From below (the eye under the sea): the sky through Snell's window, the cone of rays that
      // leave the water (the critical angle about the wave normal, its rim softened), and total
      // internal reflection outside it, which mirrors the water body (the fog's colour).
      vec3 t=refract(-V,-Nw,1.333);
      if(dot(t,t)<.5) t=n;
      vec3 thru=grSky(t,n,s,skyScale,a2,detail)*(1.-grFresnel(max(dot(t,Nw),0.)))
        +sun*shadow*GR_DIRECT*GR_GLINT_GAIN*8.*smoothstep(.999,.9998,dot(t,s));
      return mix(c,mix(waterFog.rgb,thru,smoothstep(GR_SNELL.x,GR_SNELL.y,dot(-Nw,V))),water);
    }
#endif
    float nv=max(dot(Nw,V),1e-3), nl=max(dot(Nw,s),0.);
    vec3 H=normalize(V+s);
    float F=grFresnel(nv);
    vec3 r=reflect(-V,Nw);
    vec3 sky=grSky(r,n,s,skyScale,a2,detail);
    vec3 lf=floorL+sun*GR_DIRECT*max(dot(n,s),0.)*shadow+skyL+lamp;
    vec3 glint=min(vec3(GR_GLINT),3.14159265*grGGX(max(dot(Nw,H),0.),a2)*grVis(nl,nv,a2)*grFresnel(max(dot(H,V),0.))*nl*GR_GLINT_GAIN*GR_DIRECT*sun*shadow);
    vec3 wet=albedo*(1.-F)*lf+F*sky+glint;
    c=mix(c,wet,water);
    c=mix(c,.75*lf,foam*water);
  }
  if(paint.a>0.){
